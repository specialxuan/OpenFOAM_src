include ../../../buildDefs.include

EXE_INC = \
    $(FOAM_VERSION) \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I../../../src/modules/solver/lnInclude \
    -I../../../src/modules/hisa/lnInclude \
    -I../../../src/solvers/lnInclude

EXE_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -L$(FOAM_USER_LIBBIN) \
    -lmySolverModule \
    -lmyHisaModule \
    -lmyHisaSolvers \
    -lmyHisaFunctionObjects \
    -lmyHisaMeshRebalancing

ifeq ($(shell expr $(MAJ_VER) \>= 2206), 1)
    EXE_LIBS += -lthermoTools
endif

