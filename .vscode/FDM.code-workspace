{
	"folders": [
		{
			"path": ".."
		},
		{
			"path": "/root/Workspace"
		}
	],
	"settings": {
		"editor.fontFamily": "Sarasa Term SC Nerd",
		"terminal.integrated.fontFamily": "Sarasa Term SC Nerd",
		"files.exclude": {
			".clang-format": true,
			"**/.agents": true,
			"**/.cache": true,
			"**/.codegraph": true,
			"**/.codex": true,
			"**/.git/**": true,
			"**/.omo": true,
			"**/.opencode": true,
			"**/.venv_fdm": true,
			"**/linux64GccDPInt32Opt": true,
			"**/lnInclude": true,
			"**/__pycache__": true,
			"package-lock.json": true,
			"package.json": true
		},
		"files.watcherExclude": {
			"**/.cache/**": true,
			"**/.codegraph/**": true,
			"**/.codex/**": true,
			"**/.git/**": true,
			"**/.omo/**": true,
			"**/.opencode/**": true,
			"**/.venv_fdm/**": true,
			"**/linux64GccDPInt32Opt/**": true,
			"**/lnInclude/**": true,
			"**/__pycache__/**": true,
			"/root/Workspace/**": true
		},
		"search.exclude": {
			"**/.cache/**": true,
			"**/.codegraph/**": true,
			"**/.codex/**": true,
			"**/.git/**": true,
			"**/.omo/**": true,
			"**/.opencode/**": true,
			"**/.venv_fdm": true,
			"**/linux64GccDPInt32Opt": true,
			"**/lnInclude": true,
			"**/__pycache__/**": true,
			"/root/Workspace/**": true
		}
	}
}