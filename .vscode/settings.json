{
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "/usr/bin/clangd",
    "editor.wordWrap": "off",
    "cSpell.words": [
        "Allclean",
        "anipulation",
        "Coeffs",
        "Coor",
        "Deviatoric",
        "ield",
        "libfast",
        "libso",
        "openfoam",
        "patchi",
        "pcorr",
        "peration",
        "Pstream",
        "Reff",
        "symm",
        "Turb",
        "wmake"
