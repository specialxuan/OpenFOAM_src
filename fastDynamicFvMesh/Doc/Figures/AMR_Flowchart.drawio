                </mxCell>
                <mxCell id="legend" value="图例:&#xa;🟢 绿色 = 配置/初始化&#xa;🔵 蓝色 = 主流程步骤&#xa;🔶 橙色菱形 = 条件判断&#xa;🟣 紫色 = 插值类型&#xa;🟡 黄色 = 循环/关键目的&#xa;🔴 红色 = 警告/过滤&#xa;⬜ 灰色虚线框 = 阶段分组" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;verticalAlign=top;whiteSpace=wrap;richText=1;fontSize=10;spacing=4;" parent="1" vertex="1">
                    <mxGeometry x="880" y="70" width="180" height="140" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
