<mxfile host="65bd71144e">
    <diagram id="fastDynamicFvMesh-flowchart" name="快速动网格方法流程图">
        <mxGraphModel dx="516" dy="561" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="fastDynamicFvMesh 快速动网格方法流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;richText=1;fontSize=18;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="200" y="10" width="450" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="phase1_label" value="【初始化阶段】构造函数 (Constructor)" style="text;html=1;strokeColor=none;fillColor=#FFF2CC;align=center;verticalAlign=middle;whiteSpace=wrap;richText=1;fontSize=13;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="280" y="50" width="300" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="step1" value="读取 dynamicMeshDict 配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="95" width="300" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="step2" value="readControls()&#xa;解析并校验运行时参数&#xa;(theta, fsiPatches, couplingRelaxation等)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="140" width="300" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="step3" value="readModeShapes()&#xa;读取 mode/ 目录模态数据&#xa;(FluidNodeCoor.csv, FluidNodeDisp*.csv)&#xa;构建 CSV节点→网格点 映射" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="200" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="step4" value="buildForceProjectionCaches()&#xa;预计算 faceModeProjection_ 面-模态投影缓存&#xa;预计算 pressureScaleCache_ 压力缩放缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="270" width="300" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="step5" value="readRestartStateStore()?&#xa;非零时刻重启?&#xa;→ 是: 读取 modeState/modeForce 等&#xa;→ 否: 初始化零状态" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="330" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="phase2_label" value="【时间步进循环】每个时间步调用 update()" style="text;html=1;strokeColor=none;fillColor=#FFF2CC;align=center;verticalAlign=middle;whiteSpace=wrap;richText=1;fontSize=13;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="280" y="420" width="300" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="step6" value="识别是否为当前物理时间首次调用&#xa;记录 CPU 计时起点 (trackTiming)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="455" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="step7" value="runtimeRefinementEnabled_?&#xa;需要网格加密?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="505" width="300" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="step7_yes" value="是: 执行 dynamicRefineFvMesh 加密/反加密&#xa;拓扑变化 → updateMesh() 触发 2/4/8 插值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="280" y="560" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="step8" value="calcModalForces()&#xa;1. 读取压力场 p (支持运动学压力)&#xa;2. 计算各面压力力 + 剪切力&#xa;3. 投影到模态坐标 → modeForce_&#xa;   (使用 faceModeProjection_ 缓存)&#xa;4. 并行 reduce(sumOp) 归约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="615" width="300" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="step9" value="力松弛&#xa;appliedModeForce_ = appliedModeForce_old&#xa;  + couplingRelaxation × (modeForce_ - appliedModeForce_old)&#xa;计算 fsiResidual_ = |modeForce_ - appliedModeForce_old|" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="710" width="300" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="step10" value="solveStructuralDynamics(dt)&#xa;Wilson-Theta 法积分模态动力学&#xa;更新 modeState_ = (disp, vel, acc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="785" width="300" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="step11" value="位移增量限制&#xa;|dDisp| &gt; maxDispChange_? → 截断" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="845" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="step12" value="movePoints(newPoints)&#xa;更新网格点位置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="895" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="step13" value="writeDiagnostics()?&#xa;写 modal_diagnostics.csv" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="945" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="step14" value="writeTime()?&#xa;到达写出时刻?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="995" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="step14_yes" value="是: writeRestartStateStore()&#xa;写 constant/fsi_restart/&#xa;  modeState, modeForce&#xa;  appliedModeDisp, appliedModeForce&#xa;输出 FSI timing 报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="280" y="1045" width="300" height="70" as="geometry"/>
                </mxCell>
